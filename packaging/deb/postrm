#!/bin/sh
set -e

PKG=natstream

case "$1" in
    remove|purge)
        if [ -d /run/systemd/system ]; then
            systemctl disable "${PKG}.service" >/dev/null 2>&1 || true
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
        ;;
esac

# /etc/default/natstream is a conffile; dpkg removes it on purge.

exit 0
